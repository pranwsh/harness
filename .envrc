# Entering this directory loads the flake's devShell into your environment,
# so `cargo build` / `cargo test` work directly without a global toolchain.
#
# The C compiler that `ring` needs to link build scripts comes from
# `stdenv.cc` in devShells.default (see flake.nix) — it is project-local and
# does NOT require installing gcc system-wide.
#
# direnv caches the built shell under .direnv/ and reloads automatically when
# flake.nix or flake.lock changes.
watch_file flake.nix
watch_file flake.lock

use_flake
